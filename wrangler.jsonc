{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricci-garage",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ricci-garage",
      // À remplacer par l'identifiant renvoyé par `npx wrangler d1 create ricci-garage`
      "database_id": "b2880ee0-4a42-4227-b598-3ea2b4b8ed55",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ricci-garage-photos" }],
  "observability": { "enabled": true }
}