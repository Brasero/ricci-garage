{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricci-garage",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Le Worker reçoit TOUTES les requêtes : rien n'est servi sans session valide.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ricci-garage",
      "database_id": "b2880ee0-4a42-4227-b598-3ea2b4b8ed55",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ricci-garage-photos" }],
  // Rappels par email (toutes les 15 min) et synchronisation Google Agenda (décalée de 5 min).
  "triggers": { "crons": ["*/15 * * * *", "5,20,35,50 * * * *"] },
  "observability": { "enabled": true }
}